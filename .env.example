# Copy sang .env rồi điền key. Không commit .env.
#
# ---------------------------------------------------------------------------
# LLM provider (bắt buộc để chạy với model thật; bỏ trống = offline stub backend)
# ---------------------------------------------------------------------------

# --- Cách A: OpenRouter (OpenAI-compatible gateway) ---
OPENAI_API_KEY=sk-or-v1-DIEN_KEY_CUA_BAN_VAO_DAY
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini
# Model khác: anthropic/claude-3.5-haiku | meta-llama/llama-3.3-70b-instruct
# Model id giữ nguyên prefix vendor. Giá nằm ở PRICING_USD_PER_MTOK
# trong src/multi_agent_research_lab/services/llm_client.py

# --- Cách B: OpenAI trực tiếp ---
# Bỏ trống / xóa OPENAI_BASE_URL, dùng model id không prefix.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Tùy chọn: search provider cho ResearcherAgent
# Bỏ trống = dùng mock corpus trong services/search_client.py
# ---------------------------------------------------------------------------
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Tùy chọn: tracing. Bỏ trống = trace JSON local (--trace-out)
# Chọn MỘT trong hai.
# ---------------------------------------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multi-agent-research-lab

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------------------------------------------------------------------------
# Runtime + guardrails
# ---------------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
MAX_ITERATIONS=6
TIMEOUT_SECONDS=60
